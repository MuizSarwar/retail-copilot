# Retail Copilot - Environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Application
APP_NAME=Retail Copilot
APP_ENV=development
PORT=8000

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://retail:retail@localhost:5432/retail_copilot

# JWT authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Embedding service
EMBEDDING_SERVICE_URL=http://embedding:8001/embed
EMBEDDING_DIMENSION=384

# Seed script credentials (placeholders only — fill in real .env)
SEED_ADMIN_EMAIL=admin@retailcopilot.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_EMPLOYEE_EMAIL=employee@retailcopilot.local
SEED_EMPLOYEE_PASSWORD=change-me-employee-password

# Test database (used only during pytest, never in production)
# Must point to a DIFFERENT database than DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://retail:retail@localhost:5433/retail_copilot_test
